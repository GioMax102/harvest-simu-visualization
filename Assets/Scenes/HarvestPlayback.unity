  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Veh\xEDculos</b>\nCosechadora: m\xE1quina con cabezal maicero\nCarro:
    tractor con carro tolva\nAnillo en el suelo: color propio de cada agente\nAnillo
    pulsa <color=#ff8a75>rojo</color>: restricci\xF3n \xB7 <color=#79d98d>verde</color>:
    recarga\n\n<b>Subasta</b>\nArco <color=#8fbcff>azul</color>: solicitud de servicio
    (cfp)\nArco <color=#f2b33d>naranja</color>: carro ganador hasta terminar la transferencia\nOferta
    en la placa: costo de la propuesta\n\n<b>Campo</b>\nMa\xEDz en pie: pendiente
    \xB7 rastrojo: cosechado\nMa\xEDz m\xE1s oscuro: m\xE1s rendimiento\n\xC1rboles
    y rocas: obst\xE1culos \xB7 silos: bodega \xB7 tanques: bases\n\n<b>C\xE1mara</b>\nClic
    derecho: girar \xB7 rueda: acercar \xB7 clic central o WASD: mover\nClic en un
    veh\xEDculo o en su tarjeta: seguirlo \xB7 F: encuadrar\nVista cenital: desde
    arriba"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
